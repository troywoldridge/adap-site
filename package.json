{
  "name": "adap-site",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "engines": {
    "node": ">=18 <=22"
  },
  "scripts": {
    "db:introspect": "drizzle-kit introspect",
    "build:data": "node scripts/buildSiteData.cjs",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "seed:subcategories": "pnpm exec ts-node --esm scripts/seed-subcategories.ts",
    "generate:migrations": "pnpm drizzle-kit generate",
    "push:schema": "pnpm drizzle-kit push",
    "generate:types": "pnpm drizzle-kit generate:types",
    "build:hashes": "pnpm tsx scripts/buildAllOptionHashes.ts",
    "watch:hashes": "nodemon --watch drizzle/migrations/schema.ts --exec \"pnpm build:hashes\"",
    "sync:sinalite": "node scripts/syncSinalite.js",
    "export:hero-analytics": "node scripts/parse-hero-analytics.js",
    "deploy:full": "bash scripts/deploy.sh develop origin",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:up": "psql \"$DATABASE_URL\" -f ./sql/01_sinalite_catalog.sql",
    "sync:product": "tsx ./scripts/sync-product.ts",
    "cache:price": "tsx ./scripts/cache-price.ts",
    "cache:ship": "tsx ./scripts/cache-ship.ts",
    "sync:batch": "tsx scripts/sync-batch.ts",
    "sina:all": "bash scripts/sina_all.sh",
    "postinstall": "node -e \"try{require('fs').accessSync('scripts/install-stripe-cli.mjs'); require('child_process').execSync('node scripts/install-stripe-cli.mjs',{stdio:'inherit'});}catch(e){console.log('postinstall: stripe cli step skipped');}\"",
    "stripe:login": "tools/stripe/stripe login",
    "stripe:listen": "tools/stripe/stripe listen --forward-to http://localhost:3000/api/stripe/webhook --events checkout.session.completed,checkout.session.async_payment_succeeded,checkout.session.async_payment_failed,checkout.session.expired,payment_intent.succeeded,payment_intent.payment_failed",
    "stripe:trigger:success": "tools/stripe/stripe trigger checkout.session.completed",
    "test": "vitest",
    "test:run": "vitest run",
    "test:watch": "vitest --watch",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "@algolia/autocomplete-theme-classic": "^1.19.2",
    "@aws-sdk/client-s3": "^3.864.0",
    "@aws-sdk/s3-request-presigner": "^3.864.0",
    "@clerk/nextjs": "^6.30.0",
    "@react-email/components": "^0.5.0",
    "@react-email/render": "^1.2.0",
    "@stripe/react-stripe-js": "^4.0.0",
    "@stripe/stripe-js": "^7.9.0",
    "@upstash/ratelimit": "^2.0.6",
    "@upstash/redis": "^1.35.3",
    "@vercel/og": "^0.8.5",
    "algoliasearch": "^4.14.2",
    "archiver": "^7.0.1",
    "axios": "^1.11.0",
    "chalk": "^5.5.0",
    "cli-progress": "^3.12.0",
    "clsx": "^2.1.1",
    "dotenv": "^17.2.1",
    "drizzle-kit": "^0.31.4",
    "drizzle-orm": "^0.44.3",
    "fuse.js": "^7.1.0",
    "instantsearch.css": "^8.5.1",
    "json2csv": "6.0.0-alpha.2",
    "lucide-react": "^0.536.0",
    "next": "15.5.7",
    "node-fetch": "^3.3.2",
    "nprogress": "^0.2.0",
    "p-limit": "^7.1.0",
    "pdfkit": "^0.17.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-icons": "^5.5.0",
    "react-instantsearch": "^7",
    "react-instantsearch-hooks-web": "^6.47.3",
    "react-intersection-observer": "^9.16.0",
    "resend": "^6.0.1",
    "satori": "^0.16.2",
    "sharp": "^0.34.3",
    "slugify": "^1.6.6",
    "stripe": "^18.4.0",
    "swr": "^2.3.4",
    "zod": "^4.0.16"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.0",
    "@eslint/eslintrc": "^3",
    "@opennextjs/cloudflare": "^1.16.1",
    "@playwright/test": "^1.57.0",
    "@tailwindcss/postcss": "^4.1.12",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/archiver": "^6.0.3",
    "@types/node": "^20.19.9",
    "@types/nprogress": "^0.2.3",
    "@types/pdfkit": "^0.17.2",
    "@types/pg": "^8.15.4",
    "@types/react": "^18.2.21",
    "@types/react-dom": "^18.2.7",
    "@vitest/ui": "^4.0.15",
    "autoprefixer": "^10.4.21",
    "axe-core": "^4.11.0",
    "dotenv-cli": "^8.0.0",
    "eslint": "^9",
    "eslint-config-next": "15.5.7",
    "jsdom": "^27.2.0",
    "pg": "^8.16.3",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.11",
    "ts-node": "^10.9.2",
    "tsx": "^4.20.3",
    "typescript": "^5.5",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.2.4",
    "wrangler": "^4.61.1"
  }
}
