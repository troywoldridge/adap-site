{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    // ✅ Let Next/TS include the right type packages automatically
    // (removing custom typeRoots + hard-coded "types")
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "allowJs": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "incremental": true,
    // ✅ Required for Next 14 subpath exports like "next/navigation"
    "module": "ESNext",
    "moduleResolution": "Bundler",
    // Aliases
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "src/*"
      ],
      "@components/*": [
        "src/components/*"
      ],
      "@lib/*": [
        "src/lib/*"
      ],
      "@drizzle/*": [
        "src/drizzle/*"
      ],
      "@types/*": [
        "src/types/*"
      ],
      "@schema/*": [
        "src/drizzle/migrations/*"
      ]
    },
    // Next plugin
    "plugins": [
      {
        "name": "next"
      }
    ],
    "jsx": "preserve"
  },
  "include": [
    "next-env.d.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    "scripts/**/*.ts",
    "scripts/**/*.js",
    ".next/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
